        echo "  be derived, so no explicit git context can be pinned. Blocking rather than falling" >&2
        echo "  back to discovery, which is the thing being pinned." >&2
        exit $_AX_HRM_EXIT
    fi
    case "$AX_GIT_BIN" in "$AX_GIT_BOUND_ROOT"/*) _ax_htop=repo ;; *) _ax_htop="" ;; esac
    case "$AX_PY_BIN" in "$AX_GIT_BOUND_ROOT"/*) _ax_htop=repo ;; esac
    if [ -n "$_ax_htop" ]; then
        echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNUSABLE — git/python3 resolved to a binary INSIDE the" >&2
        echo "  repository being verified ($AX_GIT_BIN / $AX_PY_BIN). The tree under audit does not" >&2
        echo "  get to supply the programs that audit it." >&2
        exit $_AX_HRM_EXIT
    fi
    unset _ax_hcan _ax_htop
fi

if [[ -L "$_PP_LIB_DIR/pre-push-lib.sh" ]]; then
    echo "[practices] ✗ HELPER_PATH_NOT_REGULAR — .githooks/pre-push-lib.sh is a SYMLINK." >&2
    echo "[practices]   It decides which refs ship work and whether the R25 recency guard is" >&2
    echo "[practices]   handed the remote's advertised anchor sha. Push BLOCKED." >&2
    exit 1
fi
if [[ ! -f "$_PP_LIB_DIR/pre-push-lib.sh" ]]; then
    echo "[practices] ✗ .githooks/pre-push-lib.sh is missing — the push gate cannot decide" >&2
    echo "[practices]   anything without it, so it BLOCKS rather than degrading silently." >&2
    exit 1
fi
# ROUND 5 / P1-1: the root is NOT taken from `git rev-parse` any more — that read is exactly what
# GIT_DIR/GIT_WORK_TREE redirect. It is derived from this hook's own location (core.hooksPath is
# .githooks INSIDE the repository) and the hermetic bootstrap above has already REQUIRED git to
# agree that this is the toplevel (GIT_CONTEXT_REDIRECTED otherwise). A push whose gate ran
# against a different repository is the whole point of that check.
# Fail-closed: on a root that git cannot answer for, the mode/replace probes below cannot run —
# and "could not check" must not be spelled the same way as "checked, fine".
if [[ -z "${AX_GIT_BOUND_ROOT:-}" ]]; then
    echo "[practices] ✗ GIT_CONTEXT_UNUSABLE — $_PP_SELF_ROOT is not a git work tree git can" >&2
    echo "[practices]   answer for, so the push gate cannot verify its own helper, the absence of" >&2
    echo "[practices]   replacement refs, or which commits ship. Push BLOCKED." >&2
    exit 1
fi
# (The probes below used to be conditional on a `git rev-parse` succeeding — the fail-open this
# round removed. They are unconditional now: reaching this line already means git answered for
# this root, because the check above BLOCKS when it did not.)
if true; then
    _PP_LIB_MODE="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" ls-tree HEAD -- .githooks/pre-push-lib.sh 2>/dev/null | head -1)"
    _PP_LIB_MODE="${_PP_LIB_MODE%% *}"
    case "${_PP_LIB_MODE:-}" in
        100644|100755|"") ;;
        *) echo "[practices] ✗ HELPER_PATH_NOT_REGULAR — .githooks/pre-push-lib.sh has git mode" >&2
           echo "[practices]   ${_PP_LIB_MODE} at HEAD (not a regular file blob). Push BLOCKED." >&2
           exit 1 ;;
    esac
    # A repository carrying git REPLACEMENT REFS can answer every history question above out of a
    # fabricated object graph while every sha stays authentic. The ratcheting guards refuse to
    # run on such a tree; the push gate refuses to publish from one.
    # ROUND 5: an enumeration FAILURE is no longer spelled as "none present".
    _PP_REPLACE="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" for-each-ref --format='%(refname)' refs/replace/ 2>/dev/null)"
    if [[ $? -ne 0 ]]; then
        echo "[practices] ✗ ANCHOR_REPLACE_REFS_PRESENT — the replacement-ref enumeration FAILED, so" >&2
        echo "[practices]   this gate cannot tell whether refs/replace/* is empty. That decides" >&2
        echo "[practices]   whether every sha below is read from a fabricated graph. Push BLOCKED." >&2
        exit 1
    fi
    if [[ -n "$_PP_REPLACE" ]]; then
        echo "[practices] ✗ ANCHOR_REPLACE_REFS_PRESENT — this repository carries replacement refs:" >&2
        echo "$_PP_REPLACE" | sed 's/^/[practices]     /' >&2
        echo "[practices]   They keep shas identical while swapping the objects every git command" >&2
        echo "[practices]   reads, so the ratchets' ancestry/bootstrap checks and this gate's sha" >&2
        echo "[practices]   comparisons can all be satisfied from a history somebody wrote." >&2
        echo "[practices]   Remove them (git replace -d <ref>) and re-run R25. Push BLOCKED." >&2
        exit 1
    fi
fi
# Source the pure decision logic before cd (resolve relative to this hook file).
# ── BACKLOG P3-116: THE THING VERIFIED MUST BE THE THING SOURCED ────────────────────
# The lstat and the git-mode check above both name a PATH, and `source` resolves that path
# AGAIN — two resolutions with a window between them, in which a rename substitutes a different
# regular file that satisfies every check already made (they ask about the path's TYPE, not its
# CONTENT). The bytes are therefore copied ONCE into a private 0700 directory owned by this euid
# (_ax_mktemp_d, BACKLOG P2-67), that COPY is hashed against the blob git records for the path at
# HEAD, and the same copy — not the path — is sourced. A corrupted copy (a hostile `cat` on PATH)
# fails the same hash, so the copy step is not trusted either. Applied only where a committed
# blob exists to bind to; an untracked lib keeps the old load path rather than being copied
# without verification.
# shellcheck source=.githooks/pre-push-lib.sh
_PP_LIB_PRIV=""
_PP_LIB_LOAD="$_PP_LIB_DIR/pre-push-lib.sh"
_PP_LIB_WANT="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" rev-parse --verify --quiet "HEAD:.githooks/pre-push-lib.sh" 2>/dev/null)"
if [[ -n "$_PP_LIB_WANT" ]]; then
    _PP_LIB_PRIV="$(_ax_mktemp_d "pre-push")" || exit 1
    if ! cat -- "$_PP_LIB_DIR/pre-push-lib.sh" > "$_PP_LIB_PRIV/pre-push-lib.sh" 2>/dev/null; then
        echo "[practices] ✗ HELPER_BYTES_UNBOUND — .githooks/pre-push-lib.sh could not be copied" >&2
        echo "[practices]   into a private directory, so the bytes that would be SOURCED cannot be" >&2
        echo "[practices]   bound to the bytes that were CHECKED. Push BLOCKED." >&2
        rm -rf "$_PP_LIB_PRIV"; exit 1
    fi
    _PP_LIB_HAVE="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" hash-object --no-filters -t blob --stdin < "$_PP_LIB_PRIV/pre-push-lib.sh" 2>/dev/null)"
    if [[ "$_PP_LIB_WANT" != "$_PP_LIB_HAVE" ]]; then
        echo "[practices] ✗ HELPER_BYTES_UNBOUND — the copy of .githooks/pre-push-lib.sh this push" >&2
        echo "[practices]   is about to source hashes ${_PP_LIB_HAVE:-<unreadable>}, but git records" >&2
        echo "[practices]   ${_PP_LIB_WANT} for that path at HEAD. Either the file is edited but" >&2
        echo "[practices]   uncommitted, or it was replaced between the checks above and this read." >&2
        echo "[practices]   The push gate does not load its decision policy from an implementation" >&2
        echo "[practices]   nobody has committed. Commit it and re-push." >&2
        rm -rf "$_PP_LIB_PRIV"; exit 1
    fi
    _PP_LIB_LOAD="$_PP_LIB_PRIV/pre-push-lib.sh"
fi
source "$_PP_LIB_LOAD"
[[ -n "$_PP_LIB_PRIV" ]] && rm -rf "$_PP_LIB_PRIV"
unset _PP_LIB_PRIV _PP_LIB_LOAD _PP_LIB_WANT _PP_LIB_HAVE

ROOT="$AX_GIT_BOUND_ROOT"
builtin cd "$ROOT"

# ── ROUND 6 / P1-3: THE PUSH-TIME CONSUMER MUST NOT AUTHENTICATE ITSELF ──────────────
# (TD-2026-07-30-P1-preflight-and-raw-bytes.)
# THE DEFECT, stated plainly: every toolchain authentication in the pipeline compared the working
# tree to HEAD. HEAD is the thing being shipped, so a COMMITTED backdoor equals HEAD and certifies
# itself. MEASURED — inserting
#     if [ -n "$EXPECT_SHA" ]; then exit 0; fi
# immediately after the recency guard's argument parsing and COMMITTING it made
# `.githooks/pre-push` exit 0 on a tree with NO audit log at all (honest baseline 1). Nothing else
# saw it: run-all-guards drives that guard with --fixtures, the falsification proofs omit
# --expect-sha, and the only caller that takes the backdoored path is this hook.
#
# THE ANSWER, and why this shape: authentication must be against a copy the pushed commit cannot
# edit — the PREVIOUS RELEASE, as advertised by the REMOTE (git hands this hook that sha; no local
# `git update-ref` can rewrite it). So before the tree's own recency guard is invoked at all, the
# ANCHOR's copy of it is extracted OUT OF GIT into a directory outside the tree and RUN against
# the live root with the same arguments. Both verdicts must be PASS.
#   · An argument-triggered early exit cannot short-circuit this: it happens BEFORE the tree copy
#     runs, in the hook, not inside the guard.
#   · Byte-equality with the anchor is deliberately NOT required — that would make every
#     legitimate change to these files unpushable forever. Running the prior implementation is the
#     weaker, correct claim: a release must satisfy the gate that the previous release shipped.
# MIGRATION REALITY, disclosed rather than discovered later: a legitimate change to the toolchain
# ships in a release whose gate ran with the PRIOR copy. A tightening is free (the prior copy is
# more permissive). A change to what the prior copy MEASURES — the audit line's field set, the
# fingerprint algorithm's output — cannot pass this gate at all and is a deliberate human
# decision, exactly as the round-5 fingerprint binding already documented.
# HONEST RESIDUAL, because the alternative is theatre: this hook cannot authenticate ITSELF. A
# committed backdoor in .githooks/pre-push or pre-push-lib.sh is executed by git from the working
# tree, and the only thing that could catch it is the thing being subverted. What remains against
# that is off-box review of the diff. Everything else on the toolchain list — both ratcheting
# guards, run-all-guards.sh, the runner, the anchor library, the fingerprint helper and the recency
# guard — is now covered, on raw bytes, by ax_ratchet_toolchain_authentic, and the recency guard in
# particular is additionally covered by the prior-release re-run below.
# pp_private_tmpdir <ERRCODE> <what-will-run-from-it>
#   Creates and VERIFIES a private extraction directory under /tmp, prints it on stdout, returns
#   non-zero (having printed the diagnosis on stderr) when it cannot be trusted. Lifted verbatim
#   out of pp_anchor_recency_gate when P2-111(d) added a SECOND extract-and-run gate below; the
#   alternative was a byte-copy of the same 25 lines, i.e. two places to fix the next time the
#   verification is tightened.
#   The temp base is PINNED to /tmp and does NOT honour TMPDIR: TMPDIR is attacker-settable, and a
#   TMPDIR inside a git work tree would additionally make the extracted copy resolve a git context
#   (P2, closed here).
#   BACKLOG P2-67: `mktemp` was a BARE WORD here — PATH-selected, in the one function that extracts
#   the PREVIOUS RELEASE'S implementation out of git and then RUNS it. It is now the absolute
#   binary the hermetic bootstrap resolved and smoke-tested, and the returned directory is verified
#   for owner==euid + no group/other write. "mktemp -d creates mode-0700" was a claim about a
#   program this gate had not established the identity of.
pp_private_tmpdir() {
    local errcode="$1" what="$2" tmp _pp_st
    tmp="$(TMPDIR=/tmp "$AX_MKTEMP_BIN" -d /tmp/ax-ratchet.XXXXXXXX 2>/dev/null)" || tmp=""
    if [ -n "$tmp" ] && [ -d "$tmp" ] && [ ! -L "$tmp" ]; then
        _pp_st="$(stat -f '%u %Lp' "$tmp" 2>/dev/null)" || _pp_st=""
        [ -n "$_pp_st" ] || _pp_st="$(stat -c '%u %a' "$tmp" 2>/dev/null)" || _pp_st=""
        case "$_pp_st" in
            [0-9]*" "[0-7][0-7][0-7]|[0-9]*" "[0-7][0-7][0-7][0-7])
                if [ "${_pp_st%% *}" != "${EUID:-$(id -u)}" ] \
                   || [ $(( 8#${_pp_st##* } & 8#22 )) -ne 0 ]; then
                    echo "[practices] ✗ $errcode — the extraction directory" >&2
                    echo "[practices]   $tmp is owned by uid ${_pp_st%% *} and/or is group/other-writable" >&2
                    echo "[practices]   (mode ${_pp_st##* }). Another process could then replace the" >&2
                    echo "[practices]   extracted copy between extraction and run." >&2
                    rm -rf "$tmp"; tmp=""
                fi ;;
            *)  echo "[practices] ✗ $errcode — the owner/mode of $tmp could" >&2
                echo "[practices]   not be read (stat said '${_pp_st:-<nothing>}'); unknown never passes." >&2
                rm -rf "$tmp"; tmp="" ;;
        esac
    fi
    if [ -z "$tmp" ] || [ ! -d "$tmp" ] || [ -L "$tmp" ] || [ "${tmp#/}" = "$tmp" ]; then
        echo "[practices] ✗ $errcode — could not create a private extraction" >&2
        echo "[practices]   directory under /tmp. The push gate will not run $what from" >&2
        echo "[practices]   anywhere it does not control. BLOCKED." >&2
        return 1
    fi
    if "$AX_GIT_BIN" --no-replace-objects -C "$tmp" rev-parse --show-toplevel >/dev/null 2>&1; then
        echo "[practices] ✗ $errcode — the extraction directory $tmp is" >&2
        echo "[practices]   inside a git work tree, so the extracted copy would bind to THAT repo." >&2
        rm -rf "$tmp"; return 1
    fi
    printf '%s' "$tmp"
    return 0
}

pp_anchor_recency_gate() {
    local anchor_rev="$1" local_sha="$2" tmp rel want have rc
    tmp="$(pp_private_tmpdir "RATCHET_ANCHOR_COPY_UNVERIFIABLE" \
                             "the previous release's copy of the recency guard")" || return 1
    # The four files the extracted guard reads: itself, the runner (its schema pin), the
    # fingerprint helper (its recompute fallback) and the anchor library (kept for parity with the
    # toolchain list). Written with plain redirection — never `$(git cat-file …)`, which strips
    # trailing newlines and would make the extracted copy differ from the blob it claims to be
    # (P2, closed here) — and then each extracted file's RAW hash is required to equal the blob id
    # git records at the anchor.
    # The recency guard itself is MANDATORY — it is the program being run. The other three are
    # extracted WHEN THE ANCHOR HAS THEM: the guard reads the runner only for its schema pin and
    # the fingerprint helper only as a recompute fallback, and both are already written to degrade
    # honestly when absent. A tree that never carried them is a legitimate shape (a fork that took
    # the hook but not the runner); requiring them would be a false positive with no attack behind
    # it, and the mandatory one is the one that matters.
    for rel in "practices/evals/completion_checklist_recency_guard.sh" \
               "practices/scripts/verify-completion.sh" \
               "practices/scripts/lib/tree_fingerprint.py" \
               "practices/scripts/lib/release_anchor.sh"; do
        want="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${anchor_rev}:${rel}" 2>/dev/null)"
        if [ -z "$want" ]; then
            case "$rel" in
                "practices/evals/completion_checklist_recency_guard.sh")
                    echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — ${rel} does not exist at the" >&2
                    echo "[practices]   previous release ${anchor_rev:0:12}. The push gate authenticates the" >&2
                    echo "[practices]   toolchain by RUNNING that release's copy; without it there is nothing" >&2
                    echo "[practices]   to run but the copy under audit. BLOCKED." >&2
                    rm -rf "$tmp"; return 1 ;;
                *) continue ;;
            esac
        fi
        mkdir -p "$tmp/$(dirname "$rel")" || { rm -rf "$tmp"; return 1; }
        if ! "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" cat-file blob "$want" > "$tmp/$rel" 2>/dev/null; then
            echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — could not extract ${rel} at" >&2
            echo "[practices]   ${anchor_rev:0:12}. BLOCKED." >&2
            rm -rf "$tmp"; return 1
        fi
        have="$("$AX_GIT_BIN" --no-replace-objects hash-object --no-filters -t blob -- "$tmp/$rel" 2>/dev/null)"
        if [ "$have" != "$want" ]; then
            echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — the extracted ${rel} does not hash" >&2
            echo "[practices]   to the blob it was read from (${have:-<none>} vs ${want}). BLOCKED." >&2
            rm -rf "$tmp"; return 1
        fi
    done
    echo "[practices] R25 — re-running the recency guard AS OF the previous release ${anchor_rev:0:12}"
    bash "$tmp/practices/evals/completion_checklist_recency_guard.sh" \
        --root "$ROOT" --expect-sha "$local_sha" --expect-anchor-sha "$anchor_rev"
    rc=$?
    rm -rf "$tmp"
    if [ "$rc" -ne 0 ]; then
        echo "[practices] ✗ RATCHET_PRIOR_RELEASE_GUARD_FAILED — the copy of" >&2
        echo "[practices]   completion_checklist_recency_guard.sh that the PREVIOUS RELEASE shipped" >&2
        echo "[practices]   (${anchor_rev:0:12}) refuses this push (exit $rc), whatever the copy in this" >&2
        echo "[practices]   tree says. That copy cannot have been edited by the commit being pushed," >&2
        echo "[practices]   which is the whole point: a committed backdoor in the tree's guard" >&2
        echo "[practices]   authenticates itself against HEAD and is invisible to every other check." >&2
        return 1
    fi
    echo "[practices] ✓ previous release's recency guard also PASSES"
    return 0
}

# pp_downstream_gate_rev_capable <rev>
#   True when <rev> carries BOTH files the hermetic form of the downstream release gate needs AND
#   a guard that understands the `--live-root` interface this hook invokes it with. A capability
#   PROBE rather than a version comparison: what it prevents is running an older guard with an
#   argument it never had, which exits 2 — indistinguishable from a genuine setup error, and
#   measured to be exactly what a range ending at a pre-P2-111 sha produced.
pp_downstream_gate_rev_capable() {
    local rev="$1" a m
    [ -n "$rev" ] || return 1
    a="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${rev}:practices/evals/downstream_release_recency_guard.sh" 2>/dev/null)"
    m="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${rev}:practices/scripts/lib/ax_markers.py" 2>/dev/null)"
    [ -n "$a" ] && [ -n "$m" ] || return 1
    "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" cat-file blob "$a" 2>/dev/null | grep -q -e '--live-root'
}

# pp_downstream_release_gate <local_sha> <base-or-empty> <anchor_rev-or-empty>
#   Guard [114], the downstream release gate, for ONE pushed ref. Returns 0 when the push may
#   proceed, 1 when it is BLOCKED. Three P2-111 corrections live here.
#
# (b) IT IS CALLED EVEN WHEN THE REGRESSION BASE DID NOT RESOLVE. The previous shape `continue`d
#     out of the ref loop on an unresolvable base and never reached this gate at all, which
#     contradicts the PRD's "the only blocking exit": the release gate silently disappeared for
#     exactly the pushes (root commit, shallow clone, a fork-receiver's first push) least likely to
#     have been measured. The base is now passed through as an EMPTY STRING and the guard is asked
#     anyway; it re-attempts resolution itself and, failing that, exits 3 with its own diagnosis
#     and its own restricted opt-out — a decision made by the component that can describe it.
#
# (c) APPLICABILITY LOOKS AT BOTH SIDES OF THE RANGE, not just at head. A head that carries no
#     .claude-plugin/plugin.json is two different situations: a tree that never had one (nothing
#     to check) and a push that DELETES one the base had (a decommission — something happened to
#     the release surface). Collapsing them made "delete the manifest, push, restore it later" a
#     quiet way around the gate. Applicability is therefore `head has it OR base has it`, and the
#     guard itself distinguishes and announces the decommission.
#     MEASURED, and the reason the check is not simply unconditional: three guards
#     (pre_push_decision_guard.sh, push_evidence_tree_binding_guard.sh, midrun_tree_mutation_guard.sh)
#     behavior-test THIS hook by copying it into a SYNTHETIC minimal repo — a `git init` tree with
#     docs/, backend/, .githooks/ and a stubbed recency guard, and no plugin manifest of any kind.
#     With the guard-file existence check unconditional, every one of their scenarios blocked on a
#     missing guard file: `pre_push_decision` reported s9-diff-failure-blocks as rc=1 WITHOUT the
#     expected 'git diff failed', and the two tree-binding guards reported
#     `clean-tree push : r25=0 push=1 landed=0 (want 0/0/1)` — a push that must SUCCEED was
#     blocked. Those trees have no release surface on EITHER side, so they still short-circuit.
#     UNREADABLE IS NOT ABSENT: `git ls-tree` exits 0 with EMPTY output for a path not in the tree
#     and non-zero when the rev itself cannot be read. Only the first is "not applicable"; the
#     second is "could not determine", and unknown never passes — for HEAD, which is the side that
#     can make the gate fire. A base side that cannot be read is reported and treated as "no
#     manifest there", because every outcome reachable from an absent head manifest passes anyway
#     (decommission and not-a-plugin-tree both pass); blocking on it would be a false positive with
#     no attack behind it.
#
# (d) THE GUARD AND ITS PARSER ARE NEVER RUN FROM THE WORKING CHECKOUT. Same mechanism as
#     pp_anchor_recency_gate above: extract into a verified private /tmp directory, require each
#     extracted file to hash to the blob id git records at the rev it was read from, then run THAT
#     copy against the real repository via the guard's `--live-root`. Two revs are possible and the
#     one that ran is always printed:
#       · PREVIOUS RELEASE (strong form, preferred, and the whole point of the precedent): the
#         copy cannot have been edited by the commit being pushed, so a commit that neuters
#         practices/evals/downstream_release_recency_guard.sh — or
#         practices/scripts/lib/ax_markers.py, which computes the artifact digests the gate
#         compares — does not get to be audited by its own neutered copy.
#       · PUSHED SHA (weak form, fallback): used when the previous release does not carry both
#         files, or carries a guard predating the `--live-root` interface this wiring requires.
#         It closes strictly less: only the gap between the working checkout and the pushed tree
#         (an uncommitted local edit to the guard no longer decides a push). It does NOT close
#         "the pushed commit neutered the guard". This fallback is not optional politeness — guard
#         [114] and `--live-root` are both newer than the release that is the anchor at the time
#         this is written, so demanding the strong form unconditionally would be a bootstrap
#         deadlock: the release that first ships them could never be pushed. It ratchets by
#         itself: once a release carrying both lands on the anchor branch, every later push takes
#         the strong path with no further edit here.
#     Both files are MANDATORY at whichever rev is chosen once the gate is applicable: a release
#     surface whose gate was deleted is not an inapplicable check.
#     RESIDUAL, stated rather than discovered later: this hook still cannot authenticate itself
#     (see the header's HONEST RESIDUAL), and the guard's `python3` is the ambient one.
pp_downstream_release_gate() {
    local local_sha="$1" base="$2" anchor_rev="$3"
    local pj_head pj_base pj_rc tmp="" rel want have rc gate_rev gate_form gate_path
    local -a base_args live_args

    pj_head="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" ls-tree --name-only "$local_sha" -- .claude-plugin/plugin.json 2>/dev/null)"
    pj_rc=$?
    if [ "$pj_rc" -ne 0 ]; then
        echo "[practices] ✗ the tree of ${local_sha:0:12} could not be read, so this gate cannot tell" >&2
        echo "[practices]   whether the push carries .claude-plugin/plugin.json — and therefore cannot" >&2
        echo "[practices]   tell whether the downstream release gate applies. BLOCKED (fail-closed)." >&2
        return 1
    fi

    pj_base=""
    if [ -n "$base" ]; then
        pj_base="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" ls-tree --name-only "$base" -- .claude-plugin/plugin.json 2>/dev/null)" || pj_base=""
    fi

    if [ -z "$pj_head" ] && [ -z "$pj_base" ]; then
        if [ -z "$base" ]; then
            echo "[practices] downstream release gate (guard [114]) does not apply to ${local_sha:0:12} — the"
            echo "[practices]   pushed tree carries no .claude-plugin/plugin.json, and the base side could not"
            echo "[practices]   be consulted. Both readings of that (never had one / decommission) pass, so"
            echo "[practices]   this is stated, not blocked."
        else
            echo "[practices] downstream release gate (guard [114]) does not apply to ${local_sha:0:12} — neither"
            echo "[practices]   side of this range carries .claude-plugin/plugin.json"
        fi
        return 0
    fi

    # Which rev supplies the program that will do the auditing — see (d) above. Three forms, in
    # descending strength, each one PRINTED so a run never leaves it ambiguous which it took:
    #   STRONG  — the previous release's copy. Preferred; the pushed commit cannot have edited it.
    #   WEAK    — the pushed sha's own copy, extracted and hash-verified. Closes the gap between
    #             the working checkout and the pushed tree, nothing more.
    #   LEGACY  — the working checkout's copy, run in place, exactly as this gate was wired before
    #             P2-111(d). Reached only when NEITHER rev carries a `--live-root`-capable guard.
    # The `--live-root` capability PROBE, not a version string, decides: the failure it prevents is
    # an older guard rejecting an argument it never had (exit 2, indistinguishable from a real
    # setup error — measured, that is exactly what a range ending at a pre-P2-111 sha produced).
    # The LEGACY rung exists because guard [114] and `--live-root` are both newer than the anchor
    # at the time this is written: without it the release that first ships them could never be
    # pushed, and a fork-receiver pushing an older commit would be blocked by an interface mismatch
    # rather than by anything about their release. It is NOT a new hole — it is precisely the
    # pre-P2-111(d) behaviour, and it ratchets away by itself: once a `--live-root`-capable guard
    # is on the anchor branch, the STRONG rung is taken for every later push and neither of the
    # weaker rungs can be re-entered by editing the pushed tree.
    gate_rev=""
    gate_form=""
    if [ -n "$anchor_rev" ] && [ "$anchor_rev" != "$local_sha" ] \
       && pp_downstream_gate_rev_capable "$anchor_rev"; then
        gate_rev="$anchor_rev"
        gate_form="the PREVIOUS RELEASE ${anchor_rev:0:12} (STRONG — a copy the pushed commit could not have edited)"
    elif pp_downstream_gate_rev_capable "$local_sha"; then
        gate_rev="$local_sha"
        gate_form="the PUSHED SHA ${local_sha:0:12} (WEAK — closes the working-checkout gap, NOT a guard neutered by this very commit)"
        if [ -n "$anchor_rev" ] && [ "$anchor_rev" != "$local_sha" ]; then
            echo "[practices] downstream release gate: the previous release ${anchor_rev:0:12} does not carry a"
            echo "[practices]   \`--live-root\`-capable guard plus ax_markers.py, so the STRONG rung is unavailable"
            echo "[practices]   for this push. It ratchets: the first release that ships both takes it automatically."
        fi
    fi

    if [ -z "$gate_rev" ]; then
        # LEGACY rung — no hermetic copy is obtainable. Run the checkout's guard, say so plainly.
        if [ ! -f "$ROOT/practices/evals/downstream_release_recency_guard.sh" ]; then
            echo "[practices] ✗ practices/evals/downstream_release_recency_guard.sh is missing from the" >&2
            echo "[practices]   checkout, and neither the previous release nor the pushed sha carries a" >&2
            echo "[practices]   runnable copy — yet this range HAS a plugin release surface. That is a" >&2
            echo "[practices]   release with its gate removed, not an inapplicable check. BLOCKED." >&2
            return 1
        fi
        echo "[practices] downstream release gate: neither ${anchor_rev:0:12} nor ${local_sha:0:12} carries a"
        echo "[practices]   \`--live-root\`-capable guard, so it runs from the WORKING CHECKOUT — the"
        echo "[practices]   pre-P2-111(d) wiring. NOT HERMETIC: an uncommitted edit to the guard decides"
        echo "[practices]   this push. Stated rather than silently degraded."
        gate_form="the WORKING CHECKOUT copy (LEGACY — see this function header, item (d))"
        gate_path="$ROOT/practices/evals/downstream_release_recency_guard.sh"
        live_args=()
    else
        tmp="$(pp_private_tmpdir "DOWNSTREAM_GATE_COPY_UNVERIFIABLE" \
                                 "the extracted copy of the downstream release gate")" || return 1
        for rel in "practices/evals/downstream_release_recency_guard.sh" \
                   "practices/scripts/lib/ax_markers.py"; do
            want="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${gate_rev}:${rel}" 2>/dev/null)"
            if [ -z "$want" ]; then
                echo "[practices] ✗ DOWNSTREAM_GATE_COPY_UNVERIFIABLE — ${rel} does not exist at" >&2
                echo "[practices]   ${gate_rev:0:12}, but this range DOES have a plugin release surface." >&2
                echo "[practices]   That is a release with its gate removed, not an inapplicable check. BLOCKED." >&2
                rm -rf "$tmp"; return 1
            fi
            mkdir -p "$tmp/$(dirname "$rel")" || { rm -rf "$tmp"; return 1; }
            if ! "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" cat-file blob "$want" > "$tmp/$rel" 2>/dev/null; then
                echo "[practices] ✗ DOWNSTREAM_GATE_COPY_UNVERIFIABLE — could not extract ${rel} at" >&2
                echo "[practices]   ${gate_rev:0:12}. BLOCKED." >&2
                rm -rf "$tmp"; return 1
            fi
            have="$("$AX_GIT_BIN" --no-replace-objects hash-object --no-filters -t blob -- "$tmp/$rel" 2>/dev/null)"
            if [ "$have" != "$want" ]; then
                echo "[practices] ✗ DOWNSTREAM_GATE_COPY_UNVERIFIABLE — the extracted ${rel} does not hash" >&2
                echo "[practices]   to the blob it was read from (${have:-<none>} vs ${want}). BLOCKED." >&2
                rm -rf "$tmp"; return 1
            fi
        done
        gate_path="$tmp/practices/evals/downstream_release_recency_guard.sh"
        live_args=(--live-root "$ROOT")
    fi

    base_args=()
    [ -n "$base" ] && base_args=(--base "$base")
    echo "[practices] R25 — downstream release recency check (guard [114]) for ${local_sha:0:12}, running"
    echo "[practices]   $gate_form"
    bash "$gate_path" "${live_args[@]+"${live_args[@]}"}" \
        --head "$local_sha" "${base_args[@]+"${base_args[@]}"}"
    rc=$?
    [ -n "$tmp" ] && rm -rf "$tmp"
    if [ "$rc" -ne 0 ]; then
        echo "[practices] ✗ downstream_release_recency_guard FAILED for ${local_sha:0:12} (exit $rc) — push BLOCKED"
        if [ "$rc" -eq 3 ]; then
            echo "[practices]   The guard could not resolve a base commit for this range, so it cannot tell"
            echo "[practices]   whether plugin.json's version changed, and it refuses to guess. This is the"
            echo "[practices]   ONE case AX_SKIP_DOWNSTREAM_RELEASE_GATE=1 opts out of — and it is honored"
            echo "[practices]   only here, not as a general off switch (P2-111(a))."
        else
            echo "[practices]   plugin.json's version changed in this push range, and the gate refused."
            echo "[practices]   The guard printed the reason CODE on stderr just above — read that first."
            echo "[practices]   The usual one is that no fresh GREEN"
            echo "[practices]   practices/scripts/verify-downstream.sh run exists for the pushed sha:"
            echo "[practices]   git checkout ${local_sha:0:12} && bash practices/scripts/verify-downstream.sh"
            echo "[practices]   then re-attempt the push."
            echo "[practices]   But since P2-106 the same exit 1 also carries the forgery-resistance"
            echo "[practices]   refusals, and re-running the harness will NOT clear those:"
            echo "[practices]     AX_DOWNSTREAM_LOG_SCHEMA_MISMATCH / _WRITER_SCHEMA_DRIFT — the audit"
            echo "[practices]       line's field set is not the one the harness emits."
            echo "[practices]     AX_DOWNSTREAM_DIGEST_RECOMPUTE_VACUOUS — the artifact-digest recompute"
            echo "[practices]       found no ax:artifact markers, so it would certify nothing."
            echo "[practices]     AX_DOWNSTREAM_REPLACE_REFS_PRESENT — \`git replace -d <ref>\` them; they"
            echo "[practices]       let every sha comparison be answered out of a fabricated graph."
            echo "[practices]     AX_DOWNSTREAM_ENV_UNSCRUBBABLE — start the push from a clean shell."
        fi
        return 1
    fi
    echo "[practices] ✓ downstream release recency PASS for ${local_sha:0:12}"
    return 0
}

# Git feeds (local_ref local_sha remote_ref remote_sha) on stdin per `man
# githooks`. Capture it once — every stage below consumes it. An empty stdin
# (manual invocation) falls back to a single-ref push of HEAD vs upstream.
PUSH_SPECS="$(pp_effective_push_specs "$(cat)")"

SHIPPING=0
REGRESSION_NEEDED=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -z "$local_sha" ]] && continue
    # Deletion ships no work — skip this ref. (ax-ledger dogfood_finding
    # 2026-07-10: the unconditional R25 stage was over-blocking post-merge
    # branch-deletion pushes.)
    pp_ref_is_deletion "$local_sha" && continue
    SHIPPING=1

    # R25 — 49th hard guard, per pushed ref: the audit must be fresh for the
    # EXACT sha being shipped. Verifying the checkout's HEAD instead would let
    # `git push origin feature` (while on main) ride on main's audit.
    # P1-X layer 3 (2026-07-30, TD-2026-07-30-P1-anchor-authenticity): git hands this hook the
    # remote sha from the REMOTE'S OWN ADVERTISEMENT — the only copy in the pipeline that a local
    # `git update-ref` cannot rewrite. The ratcheting guards resolve "the previous release" from
    # refs/remotes/origin/main, an ordinary local ref; aiming it at a synthetic commit that merely
    # DROPS the ratcheting files makes every ratchet bootstrap-skip and R25 pass on a downgrade.
    # So for a push that advances the ANCHOR BRANCH we require the audit's recorded anchor_sha to
    # equal what the remote actually has. Round-2 used remote_sha only to pick the regression
    # diff base; this is what turns it into an authentication.
    ANCHOR_ARGS=()
    ANCHOR_REV=""
    if anchor_expect="$(pp_anchor_expect_sha "$_remote_ref" "$remote_sha")"; then
        ANCHOR_ARGS=(--expect-anchor-sha "$anchor_expect")
        ANCHOR_REV="$anchor_expect"
        echo "[practices] R25 — anchor binding: remote advertises ${anchor_expect:0:12} for $_remote_ref"
    else
        # Not the anchor branch (or the remote does not have it yet): fall back to the local
        # remote-tracking ref, and SAY SO. It is a weaker statement — that ref is locally
        # writable — but running the prior implementation from it is still strictly more than
        # running only the copy under audit, and the anchor-branch push (the one that publishes)
        # always takes the authoritative path above.
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' 2>/dev/null)"
        [ -n "$ANCHOR_REV" ] && echo "[practices] R25 — no remote advertisement for $_remote_ref; prior-release copy taken from local refs/remotes/origin/main ${ANCHOR_REV:0:12} (weaker)"
    fi
    # The remote can advertise a sha this clone does not have (someone else pushed). That is a
    # legitimate state and it is ALREADY caught, by the anchor binding inside the recency guard
    # itself (--expect-anchor-sha vs the recorded anchor_sha); it must not additionally make the
    # EXTRACTION impossible-and-therefore-blocking for a reason unrelated to the attack. So the
    # extraction rev is required to be an object we hold, and degrades if it is not.
    if [ -n "$ANCHOR_REV" ] \
       && ! "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${ANCHOR_REV}^{commit}" >/dev/null 2>&1; then
        echo "[practices] R25 — the advertised previous release ${ANCHOR_REV:0:12} is not an object in this"
        echo "[practices]   clone; the prior-release copy falls back (run \`git fetch origin\` for the strong form)"
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' 2>/dev/null)"
    fi
    # Last resort: HEAD. The extracted copy is then the copy under audit, so this adds nothing —
    # it is the SAME honest degradation the round-5 fingerprint binding already documents
    # (remote advertisement → origin/main → HEAD), kept rather than turned into a block because a
    # repository with no remote-tracking branch is an ordinary fresh fork, not an attack. It is
    # printed, so a run that got the weak form says so.
    if [ -z "$ANCHOR_REV" ]; then
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)"
        [ -n "$ANCHOR_REV" ] && echo "[practices] R25 — no previous release resolvable; prior-release copy degrades to HEAD ${ANCHOR_REV:0:12} (adds nothing — stated, not hidden)"
    fi
    if [ -z "$ANCHOR_REV" ]; then
        echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — not even HEAD resolves, so this gate" >&2
        echo "[practices]   cannot obtain any copy of the recency guard to run. BLOCKED." >&2
        exit 1
    fi
    # P1-3: the PRIOR RELEASE'S guard runs FIRST, before the tree's copy has a chance to
    # short-circuit on an argument.
    pp_anchor_recency_gate "$ANCHOR_REV" "$local_sha" || exit 1
    echo "[practices] R25 — completion checklist recency check for ${local_sha:0:12}"
    if ! bash practices/evals/completion_checklist_recency_guard.sh --expect-sha "$local_sha" "${ANCHOR_ARGS[@]+"${ANCHOR_ARGS[@]}"}"; then
        echo "[practices] ✗ completion_checklist_recency_guard FAILED for ${local_sha:0:12} — push BLOCKED"
        echo "[practices] Run the completion contract at the pushed commit:"
        echo "[practices]   git checkout ${local_sha:0:12} && bash practices/scripts/verify-completion.sh"
        echo "[practices] then re-attempt the push."
        exit 1
    fi
    echo "[practices] ✓ completion checklist recency PASS for ${local_sha:0:12}"

    # Regression scope for THIS ref: remote tip when it exists, else the
    # merge-base with the default branch (new remote branch). Unresolvable
    # base → fail-closed: run the suite rather than assume out-of-scope.
    # P2-111(b): an unresolvable base no longer `continue`s straight past guard [114]. It sets the
    # regression flag, leaves `base` EMPTY, and falls through — the release gate is still asked,
    # and diagnoses the missing base itself (see pp_downstream_release_gate's header).
    BASE_UNRESOLVED=0
    if ! base="$(pp_resolve_ref_base "$local_sha" "$remote_sha")"; then
        base=""
        BASE_UNRESOLVED=1
        REGRESSION_NEEDED=1
        echo "[practices] regression base UNRESOLVED for ${local_sha:0:12} — full regression will run,"
        echo "[practices]   and the downstream release gate is still invoked below (it decides for itself)"
    fi

    # [114] downstream_release_recency_guard.sh — the release gate for THIS ref. Applicability,
    # extraction of the guard from the pushed sha, and the invocation all live in
    # pp_downstream_release_gate above (P2-111 (b)/(c)/(d) are documented at its definition).
    # The base is passed as-is: EMPTY when it did not resolve, which the guard diagnoses itself
    # rather than being silently skipped for.
    pp_downstream_release_gate "$local_sha" "$base" "$ANCHOR_REV" || exit 1

    # An unresolved base cannot be diffed for regression scope; the flag was already set above.
    if [[ "$BASE_UNRESOLVED" -eq 1 ]]; then
        continue
    fi

    # `git diff` failure (bad range, missing objects) is fail-closed: BLOCK,
    # never convert an error into a silent regression skip.
    diff_out="$(pp_diff_touches_scope "$base" "$local_sha")"; scope_rc=$?
    if [[ "$scope_rc" -eq 2 ]]; then
        echo "[practices] ✗ git diff failed for ${base:0:12}..${local_sha:0:12} — push BLOCKED (fail-closed)"
        echo "$diff_out"
        exit 1
    fi
    if [[ "$scope_rc" -eq 0 ]]; then
        REGRESSION_NEEDED=1
    fi
done <<< "$PUSH_SPECS"

if [[ "$SHIPPING" -eq 0 ]]; then
    echo "[practices] delete-only push — no commits shipped; R25 + regression skipped"
    exit 0
fi

if [[ "$REGRESSION_NEEDED" -eq 0 ]]; then
    exit 0
fi

echo "[practices] push touches regression scope — running full regression (testPractices + testAsvs + testCrud)"
if ! (cd backend && ./gradlew -q testPractices testAsvs testCrud); then
    echo "[practices] ✗ full regression FAILED — push BLOCKED"
    echo "[practices] Inspect the failing tests above. Re-run locally:"
    echo "[practices]   cd backend && ./gradlew testPractices testAsvs testCrud"
    exit 1
fi
echo "[practices] ✓ full regression PASS — push proceeds"
exit 0
