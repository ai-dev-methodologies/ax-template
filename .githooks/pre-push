#!/usr/bin/env bash
# .githooks/pre-push — full regression before pushing (advisory hook for ax-template).
#
# ax-template is a fork-base for AI transformation projects. The git workflow itself
# (branch protection, PR policy, merge strategy) is NOT enforced by this template —
# fork-받은 팀이 결정. This hook only protects catalog quality, in two stages,
# evaluated PER PUSHED REF against the exact sha being shipped (local_sha), NOT
# the checkout's HEAD — pushing a non-checked-out branch must not ride on the
# current branch's audit (confirmed cross-review P1, 2026-07-10):
#   1. R25 completion-checklist recency guard — runs for EVERY ref that ships
#      commits, regardless of which paths the push touches (a docs/frontend-only
#      push still ships work, so it still requires a fresh verify-completion.sh
#      PASS at the pushed sha). A DELETE-ONLY push (every ref is a deletion)
#      ships no work and skips both stages.
#      For a push that advances the ANCHOR BRANCH (remote ref refs/heads/main) this
#      stage ALSO authenticates the release anchor: git hands the hook the remote
#      sha from the remote's own advertisement — the one copy a local
#      `git update-ref` cannot rewrite — and the audit's recorded anchor_sha must
#      equal it. Without that, pointing refs/remotes/origin/main at a synthetic
#      commit whose tree merely DROPS the ratcheting files makes every ratchet take
#      its first-release bootstrap skip and R25 passes on a downgrade
#      (TD-2026-07-30-P1-anchor-authenticity, P1-X layer 3).
#   2. Binary regression suite (testPractices + testAsvs + testCrud) — runs when
#      ANY pushed ref's diff touches backend/, practices/, or the seed spec.
#      Fail-closed: if a ref's diff base cannot be resolved or `git diff` itself
#      fails, the suite runs / the push blocks rather than silently skipping.
#
# The per-ref decision logic (effective push specs / deletion / base resolution /
# scope) lives in .githooks/pre-push-lib.sh so it can be exercised in isolation by
# practices/evals/pre_push_decision_guard.sh. This hook's observable behavior is
# unchanged by that extraction — the lib only factors out the branch decisions.
#
# Activated by practices/scripts/install-hooks.sh together with pre-commit. The hook
# is opt-in per clone; not installing it skips the regression locally but sentinel CI
# remains the second line of defense for whichever git policy the fork-받은 팀 picks.
# ── ROUND 6 / P1-1: PURE-KEYWORD PREFLIGHT — THESE ARE THE FIRST EXECUTABLE LINES ────
# (TD-2026-07-30-P1-preflight-and-raw-bytes.) INVARIANT (α): NOTHING OVERRIDABLE MAY EXECUTE
# BEFORE THE SCRUB THAT DETECTS OVERRIDES. Round 5 put `set -uo pipefail` and `[ -n … ]` ahead of
# its own hermetic bootstrap, and both are ordinary command lookups: MEASURED —
#   BASH_FUNC_set%%='() { exit 0; }'  → .githooks/pre-push exit 0   (honest baseline 1)
#   BASH_FUNC_[%%='() { exit 0; }'    → this guard      exit 0      (honest baseline 2)
# A dependency LIST cannot fix that, because the list is consulted by code that has already run.
# So the first thing every entry does is expressed ONLY in constructs an exported function cannot
# reach:
#   · shell KEYWORDS (`if`, `case`, `for`, `[[ ]]`) — never resolved through the function table;
#   · variable ASSIGNMENT — not a command at all;
#   · ONE command invoked by ABSOLUTE PATH (`/usr/bin/env`): bash never looks a word containing a
#     slash up as a function, so this call cannot be hijacked;
#   · abort via `${x:?msg}` — a PARAMETER EXPANSION, not a command. A non-interactive shell writes
#     msg to stderr and exits non-zero. `exit`, `echo`, `printf`, `[`, `test` and `set` are all
#     shadowable and are therefore unusable at this point.
# WHY /usr/bin/env AND NOT `${!BASH_FUNC_@}`: bash imports BASH_FUNC_* out of the environment and
# then DELETES the shell variable, so the prefix expansion is EMPTY in the child while the environ
# still carries the entry (measured, bash 3.2.57 / Apple). The environ is the only place the
# channel is visible, and /usr/bin/env is the only unhijackable way to read it.
_AX_PF_LABEL="pre-push"
_AX_PF_ENV="$(/usr/bin/env)"
case "$_AX_PF_ENV" in
    "") _AX_PF_NULL=; _AX_PF_DIE=${_AX_PF_NULL:?"$_AX_PF_LABEL: HERMETIC_PREFLIGHT_UNVERIFIABLE — /usr/bin/env produced no output, so this gate cannot tell whether the environment carries exported shell functions. It is the one read that cannot be hijacked; without it, unknown never passes."} ;;
esac
case "$_AX_PF_ENV" in
    *BASH_FUNC_*) _AX_PF_NULL=; _AX_PF_DIE=${_AX_PF_NULL:?"$_AX_PF_LABEL: HERMETIC_PREFLIGHT_HOSTILE — the environment carries an exported shell function (BASH_FUNC_*). bash imports it BEFORE this script's first line, so it replaces a command this gate runs: measured, an exported set/[ turned this gate's honest exit into exit 0. Unset it (unset -f <name>) and re-run."} ;;
esac
case "${BASH_ENV:-}${ENV:-}" in
    ?*) _AX_PF_NULL=; _AX_PF_DIE=${_AX_PF_NULL:?"$_AX_PF_LABEL: HERMETIC_PREFLIGHT_HOSTILE — BASH_ENV/ENV is set, so every non-interactive bash this gate starts would source that file before running the gate's own code. Unset it and re-run."} ;;
esac
unset _AX_PF_ENV _AX_PF_NULL _AX_PF_DIE _AX_PF_LABEL
set -uo pipefail

# ── ROUND 5 / P1-1+P1-2: HERMETIC RUNTIME BOOTSTRAP (A) — DELIBERATELY DUPLICATED ────
# (TD-2026-07-30-P1-hermetic-runtime; the full argument lives in the header of
#  practices/scripts/lib/release_anchor.sh.) THE RATCHET MAY NOT INHERIT ITS OWN RUNTIME.
# Measured: an exported `git` function rewrote the anchor pin; an exported `pwd` moved the pin's
# root to a foreign repo; an exported `python3` turned a FAILING guard into exit 0; GIT_DIR/
# GIT_WORK_TREE made every read describe a CLEAN shadow checkout of a DIRTY tree. All of it
# arrives through the environment, so it must die BEFORE the first git call, BEFORE any `source`,
# and BEFORE this script computes its own directory with `cd`/`pwd` — which is exactly why these
# lines cannot live in a sourced file. The duplication IS the bootstrap.
_AX_HRM_LABEL="pre-push"; _AX_HRM_EXIT=1; _AX_HRM_NEED_PY=0
# ROUND 6 / P1-1(b): the list is now EVERY name any entry invokes anywhere, enumerated by
# grepping this catalog's own gate files — including the shell keyword-lookalikes that round 5
# omitted and that the reviewer weaponised (`set`, `[`, `test`, `printf`, `exit`, `exec`, `read`,
# `trap`, `shift`, `local`, `eval`). The pure-keyword preflight above already refuses ANY exported
# function, so this list is belt-and-braces — but a shortfall here used to BE the hole, and a list
# that is merely "what we remembered" is what round 5 shipped.
_AX_HRM_DEPS="git bash sh python python3 env cd pwd command builtin printf echo eval exec read \
test declare unset export local source grep egrep fgrep sed awk cut tr sort uniq head tail wc \
find ls cat cp mv rm mkdir rmdir mktemp dirname basename date shasum sha256sum md5sum xargs tee \
true false set exit return trap shift getopts times umask ulimit wait kill jobs let shopt \
enable alias unalias type hash caller readonly typeset mapfile readarray realpath readlink stat \
chmod touch diff cmp od base64 seq expr sleep tar gzip curl jq yq printenv id whoami uname \
install"
# Glob-metacharacter names (`[`, `[[`) cannot ride the unquoted split above — they would be
# read as bracket expressions by pathname expansion — so they are appended QUOTED at each use.
_AX_HRM_DEPS_Q="[ [["
_AX_HRM_BAD=""
for _ax_hn in $_AX_HRM_DEPS "[" "[["; do
    declare -F "$_ax_hn" >/dev/null 2>&1 && _AX_HRM_BAD="$_ax_hn"
done
if [ -n "$_AX_HRM_BAD" ]; then
    { echo "$_AX_HRM_LABEL: HELPER_FUNCTION_INJECTED — this shell already defines a function named"
      echo "  '$_AX_HRM_BAD', and that is a COMMAND THIS GATE INVOKES. bash imports exported"
      echo "  functions across \`bash script.sh\`, so the definition silently replaces the program"
      echo "  every check below runs — measured: an exported \`git\` rewrote the release-anchor pin,"
      echo "  an exported \`python3\` turned a failing guard into exit 0, an exported \`pwd\` moved the"
      echo "  pin's root to a foreign repository. Unset it (\`unset -f $_AX_HRM_BAD\`) and re-run."; } >&2
    exit $_AX_HRM_EXIT
fi
for _ax_hn in $_AX_HRM_DEPS "[" "[["; do unset -f "$_ax_hn" 2>/dev/null || true; done
# Any exported shell function that SURVIVED the scrub above is refused too — the enumeration is a
# list of what we know we call, and an unknown runtime is not a safe one. Names in this catalog's
# own namespaces are reported as HELPER_FUNCTION_INJECTED instead, because that is what they are
# and because the round-4 policy checks own that vocabulary.
_AX_HRM_FUNCS="$(/usr/bin/env | sed -n 's/^BASH_FUNC_\([A-Za-z_][A-Za-z0-9_]*\).*/\1/p' | tr '\n' ' ')"
if [ -n "${BASH_ENV:-}${ENV:-}" ]; then
    { echo "$_AX_HRM_LABEL: HERMETIC_ENV_HOSTILE — the environment sets BASH_ENV/ENV, which EVERY"
      echo "  non-interactive bash this gate starts would source before running the gate's own"
      echo "  code. That is code the gate never read, executing inside the gate. Unset it and"
      echo "  re-run — fail-closed on purpose: an unknown runtime is not a safe one."; } >&2
    exit $_AX_HRM_EXIT
elif [ -n "$_AX_HRM_FUNCS" ]; then
    case " $_AX_HRM_FUNCS " in
        *" ax_"*|*" _ax_"*|*" pp_"*)
            { echo "$_AX_HRM_LABEL: HELPER_FUNCTION_INJECTED — the environment carries an exported"
              echo "  shell function in this catalog's own namespace: ${_AX_HRM_FUNCS}"
              echo "  Those names ARE the ratchet policy — which commit the anchor is, whether an"
              echo "  absence is an honest bootstrap, which refs ship work. A definition arriving"
              echo "  from outside replaces the policy with the caller's."; } >&2 ;;
        *)
            { echo "$_AX_HRM_LABEL: HERMETIC_ENV_HOSTILE — the environment carries exported shell"
              echo "  function(s): ${_AX_HRM_FUNCS}"
              echo "  An exported function replaces a command this gate calls, after every check it"
              echo "  performs. The enumerated dependency list above is what we know we invoke; a"
              echo "  runtime carrying definitions we did not enumerate is refused rather than"
              echo "  assumed harmless. Unset them and re-run."; } >&2 ;;
    esac
    exit $_AX_HRM_EXIT
fi
# The WHOLE GIT_* family, not a denylist of the ones we thought of: every one of GIT_DIR,
# GIT_WORK_TREE, GIT_COMMON_DIR, GIT_OBJECT_DIRECTORY, GIT_ALTERNATE_OBJECT_DIRECTORIES,
# GIT_INDEX_FILE, GIT_NAMESPACE, GIT_CEILING_DIRECTORIES, GIT_CONFIG*, GIT_EXEC_PATH redirects
# what `git -C <path>` actually reads. GIT_NO_REPLACE_OBJECTS is scrubbed too and re-set below:
# inherited as 0 it RE-ENABLES replacement refs.
for _ax_hn in ${!GIT_@}; do unset "$_ax_hn" 2>/dev/null || true; done
unset BASH_ENV ENV GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_INDEX_FILE \
    GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_CEILING_DIRECTORIES GIT_CONFIG \
    GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_CONFIG_NOSYSTEM GIT_CONFIG_COUNT GIT_EXEC_PATH \
    GIT_DISCOVERY_ACROSS_FILESYSTEM 2>/dev/null || true
export GIT_NO_REPLACE_OBJECTS=1
# git and python3 are resolved ONCE, to absolute paths, from a PATH stripped of relative entries
# (a `.` on PATH is a shim in whatever directory the gate happens to run from). The inherited
# order is otherwise preserved, because forcing system directories here would silently swap the
# interpreter that carries PyYAML and make whole guards skip — a fail-open dressed as hardening.
unset AX_GIT_BIN AX_PY_BIN
_AX_HRM_PATH=""; _ax_hifs="$IFS"; IFS=:
for _ax_hd in $PATH; do
    case "$_ax_hd" in /*) ;; *) continue ;; esac
    [ -d "$_ax_hd" ] || continue
    _AX_HRM_PATH="${_AX_HRM_PATH:+$_AX_HRM_PATH:}$_ax_hd"
done
IFS="$_ax_hifs"; unset _ax_hifs _ax_hd
AX_GIT_BIN="$(PATH="$_AX_HRM_PATH" command -v git 2>/dev/null || true)"
AX_PY_BIN="$(PATH="$_AX_HRM_PATH" command -v python3 2>/dev/null || true)"
# ── ROUND 6 / P1-2: A PATH IS NOT AN IDENTITY ───────────────────────────────────────
# INVARIANT: a tool this gate runs must SAY WHAT IT IS. `-f`/`-x` FOLLOW SYMLINKS and assert
# nothing about the program: MEASURED — a symlink named python3 pointing at /usr/bin/true passed
# every lexical/`-x` test and turned the recency guard's entire python body into exit 0 (honest
# baseline 1). So each tool is (a) canonicalised through its real directory, (b) refused if it
# lives inside the tree under audit, and (c) made to IDENTIFY ITSELF by being RUN — `git --version`
# must produce a git version banner, python3 must print a python self-report under `-I -S`. A
# /usr/bin/true symlink prints nothing and is refused.
# The PYTHON* family is scrubbed for the same reason the GIT_* family is: PYTHONPATH /
# PYTHONHOME / PYTHONEXECUTABLE / PYTHONSTARTUP redirect what the interpreter IS before a single
# line of ours runs — measured, a PYTHONPATH sitecustomize.py doing `os._exit(0)` skipped the whole
# python guard (honest baseline 1). Scrubbing is belt; `-I -S` at every ratchet call site is braces.
for _ax_hn in ${!PYTHON@}; do unset "$_ax_hn" 2>/dev/null || true; done
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONEXECUTABLE PYTHONUSERBASE PYTHONWARNINGS \
    PYTHONIOENCODING PYTHONMALLOC PYTHONBREAKPOINT PYTHONDEVMODE PYTHONPYCACHEPREFIX \
    PYTHONOPTIMIZE PYTHONVERBOSE PYTHONINSPECT PYTHONCASEOK PYTHONNOUSERSITE 2>/dev/null || true
export PYTHONDONTWRITEBYTECODE=1
for _ax_hn in "git=$AX_GIT_BIN" "python3=$AX_PY_BIN"; do
    if [ "${_ax_hn%%=*}" = "python3" ] && [ "$_AX_HRM_NEED_PY" != "1" ]; then continue; fi
    _ax_hb="${_ax_hn#*=}"
    if [ -z "$_ax_hb" ] || [ "${_ax_hb#/}" = "$_ax_hb" ] || [ ! -f "$_ax_hb" ] || [ ! -x "$_ax_hb" ]; then
        { echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNUSABLE — ${_ax_hn%%=*} did not resolve to an"
          echo "  executable regular file on an absolute path (got '${_ax_hb:-<nothing>}')."
          echo "  This gate runs that program to decide whether a release may ship; it will not"
          echo "  guess, and it will not fall back to whatever the inherited PATH offers."; } >&2
        exit $_AX_HRM_EXIT
    fi
    # (a) canonicalise: the DIRECTORY is resolved with `builtin pwd -P`, so a symlinked directory
    #     on the way to the tool cannot disguise where it lives.
    _ax_hdir="$(builtin cd "$(dirname "$_ax_hb")" 2>/dev/null && builtin pwd -P)" || _ax_hdir=""
    if [ -z "$_ax_hdir" ]; then
        { echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNUSABLE — the directory of ${_ax_hn%%=*} ('$_ax_hb')"
          echo "  could not be canonicalised, so this gate cannot say where the program it is about"
          echo "  to run actually lives."; } >&2
        exit $_AX_HRM_EXIT
    fi
    _ax_hb="$_ax_hdir/$(basename "$_ax_hb")"
    # (c) identity by SELF-REPORT — the only statement about a program that a path cannot forge.
    if [ "${_ax_hn%%=*}" = "git" ]; then
        _ax_hver="$("$_ax_hb" --version 2>/dev/null)" || _ax_hver=""
        case "$_ax_hver" in
            "git version "[0-9]*) AX_GIT_BIN="$_ax_hb" ;;
            *)  { echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNAUTHENTIC — '$_ax_hb' is executable but does"
                  echo "  not identify itself as git (\`git --version\` said '${_ax_hver:-<nothing>}')."
                  echo "  Lexical absoluteness and -f/-x FOLLOW SYMLINKS and say nothing about the"
                  echo "  program: a symlink named python3 → /usr/bin/true satisfied all of them and"
                  echo "  turned an entire guard into exit 0. A tool this gate runs must say what it is."; } >&2
                exit $_AX_HRM_EXIT ;;
        esac
    else
        _ax_hver="$("$_ax_hb" -I -S -c 'import sys;sys.stdout.write("AXPY %d %d %s %s" % (sys.version_info[0], sys.version_info[1], sys.implementation.name, sys.executable or "-"))' 2>/dev/null)" || _ax_hver=""
        case "$_ax_hver" in
            "AXPY 3 "*) AX_PY_BIN="$_ax_hb" ;;
            *)  { echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNAUTHENTIC — '$_ax_hb' is executable but does"
                  echo "  not identify itself as a python3 interpreter under \`-I -S\` (it said"
                  echo "  '${_ax_hver:-<nothing>}'). MEASURED: a symlink named python3 → /usr/bin/true"
                  echo "  passed every path test and silently skipped this gate's whole python body"
                  echo "  (exit 0 where the honest answer was 1). Identity is what the program says."; } >&2
                exit $_AX_HRM_EXIT ;;
        esac
    fi
done
export AX_GIT_BIN AX_PY_BIN
# Ratchet-internal python ALWAYS runs isolated: -I ignores PYTHON* env + user site + cwd on
# sys.path, -S skips site entirely, which is what kills a sitecustomize.py payload. Exported so
# every call site in this catalog spells it the same way. NOT usable for the checklist parser,
# which needs PyYAML out of site-packages — that one call site uses -E and is preceded by an
# explicit `import yaml` capability probe that BLOCKS (never skips). See DECISIONS.md
# TD-2026-07-30-P1-preflight-and-raw-bytes.
export AX_PY_ISO="-I -S"
unset _ax_hn _ax_hb _ax_hdir _ax_hver _AX_HRM_BAD _AX_HRM_PATH

# ── P1-1 (ROUND 4, TD-2026-07-30-P1-anchor-runtime) ──────────────────────────────────
# `git replace <real> <fabricated>` keeps every sha identical while swapping the OBJECT that
# rev-parse / merge-base / diff read. This hook is the last gate before publication and every
# decision it makes is such a read; so is every read the recency guard makes below it.
export GIT_NO_REPLACE_OBJECTS=1

# ── P1-3(b) INLINE LIB PREFLIGHT — DELIBERATELY DUPLICATED (ROUND 4) ─────────────────
# `source` FOLLOWS SYMLINKS, so pre-push-lib.sh could be a link to anything and this hook would
# execute it. The check must precede the source, which means it cannot live in the lib — that
# would be the object under test certifying itself. The same ~15 lines appear in both ratcheting
# guards and in verify-completion.sh; the duplication IS the bootstrap.
_PP_LIB_DIR="$(builtin cd "$(dirname "${BASH_SOURCE[0]}")" && builtin pwd)"
_PP_SELF_ROOT="$(builtin cd "$_PP_LIB_DIR/.." && builtin pwd -P)"
# ── HERMETIC RUNTIME BOOTSTRAP (B): bind the git identity to the trusted root ────────
# Part A removed the inherited git context; this derives the real one and REQUIRES it to be the
# root this entry resolved for itself. `git -C <root>` WALKS UP when <root> is not itself a work
# tree, so without this a gate can authenticate a repository that merely CONTAINS the directory it
# is scanning. The derived gitdir/worktree are then passed EXPLICITLY on every call for this root
# (see ax_git), so nothing downstream depends on discovery at all.
# NOT exported, and unset first: a binding that could arrive from the environment would be a
# NEW redirection channel of exactly the kind part A just closed. Every entry derives its own.
unset AX_GIT_BOUND_ROOT AX_GIT_BOUND_DIR
if "$AX_GIT_BIN" -C "$_PP_SELF_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    _ax_hcan="$(builtin cd "$_PP_SELF_ROOT" 2>/dev/null && builtin pwd -P)"
    _ax_htop="$("$AX_GIT_BIN" -C "$_PP_SELF_ROOT" rev-parse --show-toplevel 2>/dev/null)"
    _ax_htop="$(builtin cd "${_ax_htop:-/nonexistent}" 2>/dev/null && builtin pwd -P)"
    if [ -z "$_ax_hcan" ] || [ "$_ax_htop" != "$_ax_hcan" ]; then
        { echo "$_AX_HRM_LABEL: GIT_CONTEXT_REDIRECTED — the git work tree answering this gate's"
          echo "  reads is '${_ax_htop:-<unresolvable>}', not the root it was invoked for"
          echo "  ('${_ax_hcan:-$_PP_SELF_ROOT}'). Every head / status / fingerprint / anchor answer would"
          echo "  then describe a different tree than the one being verified — measured: with the"
          echo "  context aimed at a clean shadow checkout, a DIRTY tree reported the clean-tree"
          echo "  fingerprint constant and a clean status."; } >&2
        exit $_AX_HRM_EXIT
    fi
    AX_GIT_BOUND_ROOT="$_ax_hcan"
    AX_GIT_BOUND_DIR="$("$AX_GIT_BIN" -C "$AX_GIT_BOUND_ROOT" rev-parse --absolute-git-dir 2>/dev/null)"
    if [ -z "$AX_GIT_BOUND_DIR" ]; then
        echo "$_AX_HRM_LABEL: GIT_CONTEXT_REDIRECTED — the gitdir of '$AX_GIT_BOUND_ROOT' could not" >&2
        echo "  be derived, so no explicit git context can be pinned. Blocking rather than falling" >&2
        echo "  back to discovery, which is the thing being pinned." >&2
        exit $_AX_HRM_EXIT
    fi
    case "$AX_GIT_BIN" in "$AX_GIT_BOUND_ROOT"/*) _ax_htop=repo ;; *) _ax_htop="" ;; esac
    case "$AX_PY_BIN" in "$AX_GIT_BOUND_ROOT"/*) _ax_htop=repo ;; esac
    if [ -n "$_ax_htop" ]; then
        echo "$_AX_HRM_LABEL: HERMETIC_TOOL_UNUSABLE — git/python3 resolved to a binary INSIDE the" >&2
        echo "  repository being verified ($AX_GIT_BIN / $AX_PY_BIN). The tree under audit does not" >&2
        echo "  get to supply the programs that audit it." >&2
        exit $_AX_HRM_EXIT
    fi
    unset _ax_hcan _ax_htop
fi

if [[ -L "$_PP_LIB_DIR/pre-push-lib.sh" ]]; then
    echo "[practices] ✗ HELPER_PATH_NOT_REGULAR — .githooks/pre-push-lib.sh is a SYMLINK." >&2
    echo "[practices]   It decides which refs ship work and whether the R25 recency guard is" >&2
    echo "[practices]   handed the remote's advertised anchor sha. Push BLOCKED." >&2
    exit 1
fi
if [[ ! -f "$_PP_LIB_DIR/pre-push-lib.sh" ]]; then
    echo "[practices] ✗ .githooks/pre-push-lib.sh is missing — the push gate cannot decide" >&2
    echo "[practices]   anything without it, so it BLOCKS rather than degrading silently." >&2
    exit 1
fi
# ROUND 5 / P1-1: the root is NOT taken from `git rev-parse` any more — that read is exactly what
# GIT_DIR/GIT_WORK_TREE redirect. It is derived from this hook's own location (core.hooksPath is
# .githooks INSIDE the repository) and the hermetic bootstrap above has already REQUIRED git to
# agree that this is the toplevel (GIT_CONTEXT_REDIRECTED otherwise). A push whose gate ran
# against a different repository is the whole point of that check.
# Fail-closed: on a root that git cannot answer for, the mode/replace probes below cannot run —
# and "could not check" must not be spelled the same way as "checked, fine".
if [[ -z "${AX_GIT_BOUND_ROOT:-}" ]]; then
    echo "[practices] ✗ GIT_CONTEXT_UNUSABLE — $_PP_SELF_ROOT is not a git work tree git can" >&2
    echo "[practices]   answer for, so the push gate cannot verify its own helper, the absence of" >&2
    echo "[practices]   replacement refs, or which commits ship. Push BLOCKED." >&2
    exit 1
fi
# (The probes below used to be conditional on a `git rev-parse` succeeding — the fail-open this
# round removed. They are unconditional now: reaching this line already means git answered for
# this root, because the check above BLOCKS when it did not.)
if true; then
    _PP_LIB_MODE="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" ls-tree HEAD -- .githooks/pre-push-lib.sh 2>/dev/null | head -1)"
    _PP_LIB_MODE="${_PP_LIB_MODE%% *}"
    case "${_PP_LIB_MODE:-}" in
        100644|100755|"") ;;
        *) echo "[practices] ✗ HELPER_PATH_NOT_REGULAR — .githooks/pre-push-lib.sh has git mode" >&2
           echo "[practices]   ${_PP_LIB_MODE} at HEAD (not a regular file blob). Push BLOCKED." >&2
           exit 1 ;;
    esac
    # A repository carrying git REPLACEMENT REFS can answer every history question above out of a
    # fabricated object graph while every sha stays authentic. The ratcheting guards refuse to
    # run on such a tree; the push gate refuses to publish from one.
    # ROUND 5: an enumeration FAILURE is no longer spelled as "none present".
    _PP_REPLACE="$("$AX_GIT_BIN" --no-replace-objects -C "$AX_GIT_BOUND_ROOT" for-each-ref --format='%(refname)' refs/replace/ 2>/dev/null)"
    if [[ $? -ne 0 ]]; then
        echo "[practices] ✗ ANCHOR_REPLACE_REFS_PRESENT — the replacement-ref enumeration FAILED, so" >&2
        echo "[practices]   this gate cannot tell whether refs/replace/* is empty. That decides" >&2
        echo "[practices]   whether every sha below is read from a fabricated graph. Push BLOCKED." >&2
        exit 1
    fi
    if [[ -n "$_PP_REPLACE" ]]; then
        echo "[practices] ✗ ANCHOR_REPLACE_REFS_PRESENT — this repository carries replacement refs:" >&2
        echo "$_PP_REPLACE" | sed 's/^/[practices]     /' >&2
        echo "[practices]   They keep shas identical while swapping the objects every git command" >&2
        echo "[practices]   reads, so the ratchets' ancestry/bootstrap checks and this gate's sha" >&2
        echo "[practices]   comparisons can all be satisfied from a history somebody wrote." >&2
        echo "[practices]   Remove them (git replace -d <ref>) and re-run R25. Push BLOCKED." >&2
        exit 1
    fi
fi
# Source the pure decision logic before cd (resolve relative to this hook file).
# shellcheck source=.githooks/pre-push-lib.sh
source "$_PP_LIB_DIR/pre-push-lib.sh"

ROOT="$AX_GIT_BOUND_ROOT"
builtin cd "$ROOT"

# ── ROUND 6 / P1-3: THE PUSH-TIME CONSUMER MUST NOT AUTHENTICATE ITSELF ──────────────
# (TD-2026-07-30-P1-preflight-and-raw-bytes.)
# THE DEFECT, stated plainly: every toolchain authentication in the pipeline compared the working
# tree to HEAD. HEAD is the thing being shipped, so a COMMITTED backdoor equals HEAD and certifies
# itself. MEASURED — inserting
#     if [ -n "$EXPECT_SHA" ]; then exit 0; fi
# immediately after the recency guard's argument parsing and COMMITTING it made
# `.githooks/pre-push` exit 0 on a tree with NO audit log at all (honest baseline 1). Nothing else
# saw it: run-all-guards drives that guard with --fixtures, the falsification proofs omit
# --expect-sha, and the only caller that takes the backdoored path is this hook.
#
# THE ANSWER, and why this shape: authentication must be against a copy the pushed commit cannot
# edit — the PREVIOUS RELEASE, as advertised by the REMOTE (git hands this hook that sha; no local
# `git update-ref` can rewrite it). So before the tree's own recency guard is invoked at all, the
# ANCHOR's copy of it is extracted OUT OF GIT into a directory outside the tree and RUN against
# the live root with the same arguments. Both verdicts must be PASS.
#   · An argument-triggered early exit cannot short-circuit this: it happens BEFORE the tree copy
#     runs, in the hook, not inside the guard.
#   · Byte-equality with the anchor is deliberately NOT required — that would make every
#     legitimate change to these files unpushable forever. Running the prior implementation is the
#     weaker, correct claim: a release must satisfy the gate that the previous release shipped.
# MIGRATION REALITY, disclosed rather than discovered later: a legitimate change to the toolchain
# ships in a release whose gate ran with the PRIOR copy. A tightening is free (the prior copy is
# more permissive). A change to what the prior copy MEASURES — the audit line's field set, the
# fingerprint algorithm's output — cannot pass this gate at all and is a deliberate human
# decision, exactly as the round-5 fingerprint binding already documented.
# HONEST RESIDUAL, because the alternative is theatre: this hook cannot authenticate ITSELF. A
# committed backdoor in .githooks/pre-push or pre-push-lib.sh is executed by git from the working
# tree, and the only thing that could catch it is the thing being subverted. What remains against
# that is off-box review of the diff. Everything else on the toolchain list — both ratcheting
# guards, run-all-guards.sh, the runner, the anchor library, the fingerprint helper and the recency
# guard — is now covered, on raw bytes, by ax_ratchet_toolchain_authentic, and the recency guard in
# particular is additionally covered by the prior-release re-run below.
pp_anchor_recency_gate() {
    local anchor_rev="$1" local_sha="$2" tmp rel want have rc
    # The temp base is PINNED to /tmp and does NOT honour TMPDIR: TMPDIR is attacker-settable, and
    # a TMPDIR inside a git work tree would additionally make the extracted copy resolve a git
    # context (P2, closed here). mktemp -d creates mode-0700 and fails if the name exists.
    tmp="$(TMPDIR=/tmp mktemp -d /tmp/ax-ratchet.XXXXXXXX 2>/dev/null)" || tmp=""
    if [ -z "$tmp" ] || [ ! -d "$tmp" ] || [ -L "$tmp" ] || [ "${tmp#/}" = "$tmp" ]; then
        echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — could not create a private extraction" >&2
        echo "[practices]   directory under /tmp. The push gate will not run the previous release's" >&2
        echo "[practices]   copy of the recency guard from anywhere it does not control. BLOCKED." >&2
        return 1
    fi
    if "$AX_GIT_BIN" --no-replace-objects -C "$tmp" rev-parse --show-toplevel >/dev/null 2>&1; then
        echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — the extraction directory $tmp is" >&2
        echo "[practices]   inside a git work tree, so the extracted guard would bind to THAT repo." >&2
        rm -rf "$tmp"; return 1
    fi
    # The four files the extracted guard reads: itself, the runner (its schema pin), the
    # fingerprint helper (its recompute fallback) and the anchor library (kept for parity with the
    # toolchain list). Written with plain redirection — never `$(git cat-file …)`, which strips
    # trailing newlines and would make the extracted copy differ from the blob it claims to be
    # (P2, closed here) — and then each extracted file's RAW hash is required to equal the blob id
    # git records at the anchor.
    # The recency guard itself is MANDATORY — it is the program being run. The other three are
    # extracted WHEN THE ANCHOR HAS THEM: the guard reads the runner only for its schema pin and
    # the fingerprint helper only as a recompute fallback, and both are already written to degrade
    # honestly when absent. A tree that never carried them is a legitimate shape (a fork that took
    # the hook but not the runner); requiring them would be a false positive with no attack behind
    # it, and the mandatory one is the one that matters.
    for rel in "practices/evals/completion_checklist_recency_guard.sh" \
               "practices/scripts/verify-completion.sh" \
               "practices/scripts/lib/tree_fingerprint.py" \
               "practices/scripts/lib/release_anchor.sh"; do
        want="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${anchor_rev}:${rel}" 2>/dev/null)"
        if [ -z "$want" ]; then
            case "$rel" in
                "practices/evals/completion_checklist_recency_guard.sh")
                    echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — ${rel} does not exist at the" >&2
                    echo "[practices]   previous release ${anchor_rev:0:12}. The push gate authenticates the" >&2
                    echo "[practices]   toolchain by RUNNING that release's copy; without it there is nothing" >&2
                    echo "[practices]   to run but the copy under audit. BLOCKED." >&2
                    rm -rf "$tmp"; return 1 ;;
                *) continue ;;
            esac
        fi
        mkdir -p "$tmp/$(dirname "$rel")" || { rm -rf "$tmp"; return 1; }
        if ! "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" cat-file blob "$want" > "$tmp/$rel" 2>/dev/null; then
            echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — could not extract ${rel} at" >&2
            echo "[practices]   ${anchor_rev:0:12}. BLOCKED." >&2
            rm -rf "$tmp"; return 1
        fi
        have="$("$AX_GIT_BIN" --no-replace-objects hash-object --no-filters -t blob -- "$tmp/$rel" 2>/dev/null)"
        if [ "$have" != "$want" ]; then
            echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — the extracted ${rel} does not hash" >&2
            echo "[practices]   to the blob it was read from (${have:-<none>} vs ${want}). BLOCKED." >&2
            rm -rf "$tmp"; return 1
        fi
    done
    echo "[practices] R25 — re-running the recency guard AS OF the previous release ${anchor_rev:0:12}"
    bash "$tmp/practices/evals/completion_checklist_recency_guard.sh" \
        --root "$ROOT" --expect-sha "$local_sha" --expect-anchor-sha "$anchor_rev"
    rc=$?
    rm -rf "$tmp"
    if [ "$rc" -ne 0 ]; then
        echo "[practices] ✗ RATCHET_PRIOR_RELEASE_GUARD_FAILED — the copy of" >&2
        echo "[practices]   completion_checklist_recency_guard.sh that the PREVIOUS RELEASE shipped" >&2
        echo "[practices]   (${anchor_rev:0:12}) refuses this push (exit $rc), whatever the copy in this" >&2
        echo "[practices]   tree says. That copy cannot have been edited by the commit being pushed," >&2
        echo "[practices]   which is the whole point: a committed backdoor in the tree's guard" >&2
        echo "[practices]   authenticates itself against HEAD and is invisible to every other check." >&2
        return 1
    fi
    echo "[practices] ✓ previous release's recency guard also PASSES"
    return 0
}

# Git feeds (local_ref local_sha remote_ref remote_sha) on stdin per `man
# githooks`. Capture it once — every stage below consumes it. An empty stdin
# (manual invocation) falls back to a single-ref push of HEAD vs upstream.
PUSH_SPECS="$(pp_effective_push_specs "$(cat)")"

SHIPPING=0
REGRESSION_NEEDED=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -z "$local_sha" ]] && continue
    # Deletion ships no work — skip this ref. (ax-ledger dogfood_finding
    # 2026-07-10: the unconditional R25 stage was over-blocking post-merge
    # branch-deletion pushes.)
    pp_ref_is_deletion "$local_sha" && continue
    SHIPPING=1

    # R25 — 49th hard guard, per pushed ref: the audit must be fresh for the
    # EXACT sha being shipped. Verifying the checkout's HEAD instead would let
    # `git push origin feature` (while on main) ride on main's audit.
    # P1-X layer 3 (2026-07-30, TD-2026-07-30-P1-anchor-authenticity): git hands this hook the
    # remote sha from the REMOTE'S OWN ADVERTISEMENT — the only copy in the pipeline that a local
    # `git update-ref` cannot rewrite. The ratcheting guards resolve "the previous release" from
    # refs/remotes/origin/main, an ordinary local ref; aiming it at a synthetic commit that merely
    # DROPS the ratcheting files makes every ratchet bootstrap-skip and R25 pass on a downgrade.
    # So for a push that advances the ANCHOR BRANCH we require the audit's recorded anchor_sha to
    # equal what the remote actually has. Round-2 used remote_sha only to pick the regression
    # diff base; this is what turns it into an authentication.
    ANCHOR_ARGS=()
    ANCHOR_REV=""
    if anchor_expect="$(pp_anchor_expect_sha "$_remote_ref" "$remote_sha")"; then
        ANCHOR_ARGS=(--expect-anchor-sha "$anchor_expect")
        ANCHOR_REV="$anchor_expect"
        echo "[practices] R25 — anchor binding: remote advertises ${anchor_expect:0:12} for $_remote_ref"
    else
        # Not the anchor branch (or the remote does not have it yet): fall back to the local
        # remote-tracking ref, and SAY SO. It is a weaker statement — that ref is locally
        # writable — but running the prior implementation from it is still strictly more than
        # running only the copy under audit, and the anchor-branch push (the one that publishes)
        # always takes the authoritative path above.
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' 2>/dev/null)"
        [ -n "$ANCHOR_REV" ] && echo "[practices] R25 — no remote advertisement for $_remote_ref; prior-release copy taken from local refs/remotes/origin/main ${ANCHOR_REV:0:12} (weaker)"
    fi
    # The remote can advertise a sha this clone does not have (someone else pushed). That is a
    # legitimate state and it is ALREADY caught, by the anchor binding inside the recency guard
    # itself (--expect-anchor-sha vs the recorded anchor_sha); it must not additionally make the
    # EXTRACTION impossible-and-therefore-blocking for a reason unrelated to the attack. So the
    # extraction rev is required to be an object we hold, and degrades if it is not.
    if [ -n "$ANCHOR_REV" ] \
       && ! "$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet "${ANCHOR_REV}^{commit}" >/dev/null 2>&1; then
        echo "[practices] R25 — the advertised previous release ${ANCHOR_REV:0:12} is not an object in this"
        echo "[practices]   clone; the prior-release copy falls back (run \`git fetch origin\` for the strong form)"
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'refs/remotes/origin/main^{commit}' 2>/dev/null)"
    fi
    # Last resort: HEAD. The extracted copy is then the copy under audit, so this adds nothing —
    # it is the SAME honest degradation the round-5 fingerprint binding already documents
    # (remote advertisement → origin/main → HEAD), kept rather than turned into a block because a
    # repository with no remote-tracking branch is an ordinary fresh fork, not an attack. It is
    # printed, so a run that got the weak form says so.
    if [ -z "$ANCHOR_REV" ]; then
        ANCHOR_REV="$("$AX_GIT_BIN" --no-replace-objects -C "$ROOT" rev-parse --verify --quiet 'HEAD^{commit}' 2>/dev/null)"
        [ -n "$ANCHOR_REV" ] && echo "[practices] R25 — no previous release resolvable; prior-release copy degrades to HEAD ${ANCHOR_REV:0:12} (adds nothing — stated, not hidden)"
    fi
    if [ -z "$ANCHOR_REV" ]; then
        echo "[practices] ✗ RATCHET_ANCHOR_COPY_UNVERIFIABLE — not even HEAD resolves, so this gate" >&2
        echo "[practices]   cannot obtain any copy of the recency guard to run. BLOCKED." >&2
        exit 1
    fi
    # P1-3: the PRIOR RELEASE'S guard runs FIRST, before the tree's copy has a chance to
    # short-circuit on an argument.
    pp_anchor_recency_gate "$ANCHOR_REV" "$local_sha" || exit 1
    echo "[practices] R25 — completion checklist recency check for ${local_sha:0:12}"
    if ! bash practices/evals/completion_checklist_recency_guard.sh --expect-sha "$local_sha" "${ANCHOR_ARGS[@]+"${ANCHOR_ARGS[@]}"}"; then
        echo "[practices] ✗ completion_checklist_recency_guard FAILED for ${local_sha:0:12} — push BLOCKED"
        echo "[practices] Run the completion contract at the pushed commit:"
        echo "[practices]   git checkout ${local_sha:0:12} && bash practices/scripts/verify-completion.sh"
        echo "[practices] then re-attempt the push."
        exit 1
    fi
    echo "[practices] ✓ completion checklist recency PASS for ${local_sha:0:12}"

    # Regression scope for THIS ref: remote tip when it exists, else the
    # merge-base with the default branch (new remote branch). Unresolvable
    # base → fail-closed: run the suite rather than assume out-of-scope.
    if ! base="$(pp_resolve_ref_base "$local_sha" "$remote_sha")"; then
        REGRESSION_NEEDED=1
        continue
    fi
    # `git diff` failure (bad range, missing objects) is fail-closed: BLOCK,
    # never convert an error into a silent regression skip.
    diff_out="$(pp_diff_touches_scope "$base" "$local_sha")"; scope_rc=$?
    if [[ "$scope_rc" -eq 2 ]]; then
        echo "[practices] ✗ git diff failed for ${base:0:12}..${local_sha:0:12} — push BLOCKED (fail-closed)"
        echo "$diff_out"
        exit 1
    fi
    if [[ "$scope_rc" -eq 0 ]]; then
        REGRESSION_NEEDED=1
    fi
done <<< "$PUSH_SPECS"

if [[ "$SHIPPING" -eq 0 ]]; then
    echo "[practices] delete-only push — no commits shipped; R25 + regression skipped"
    exit 0
fi

if [[ "$REGRESSION_NEEDED" -eq 0 ]]; then
    exit 0
fi

echo "[practices] push touches regression scope — running full regression (testPractices + testAsvs + testCrud)"
if ! (cd backend && ./gradlew -q testPractices testAsvs testCrud); then
    echo "[practices] ✗ full regression FAILED — push BLOCKED"
    echo "[practices] Inspect the failing tests above. Re-run locally:"
    echo "[practices]   cd backend && ./gradlew testPractices testAsvs testCrud"
    exit 1
fi
echo "[practices] ✓ full regression PASS — push proceeds"
exit 0
