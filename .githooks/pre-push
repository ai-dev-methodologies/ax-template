#!/usr/bin/env bash
# .githooks/pre-push — Stage 0 main-direct guard + full regression before pushing.
#
# Activated by practices/scripts/install-hooks.sh together with pre-commit.
#
# Stage 0: any push that targets refs/heads/main while the local HEAD is also main
# is blocked. main is reachable only via PR — methodology requires feature branch +
# PR + sentinel-green before merge.
#
# Stage 1: full regression (testPractices + testAsvs + testCrud) when the local
# commits ahead of the remote touch backend/, practices/, or the seed spec. No-op
# for commits that only touch docs / .github / .omc / configuration outside scope.
#
# Break-glass: same audit rule as pre-commit (PR title `[break-glass]:` + entry in
# practices/break-glass-log.md). There is no --no-verify allowance.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Capture the entire stdin payload once. Git feeds (local_ref local_sha remote_ref
# remote_sha) lines on stdin per `man githooks`; the Stage 0 guard and the regression
# range computation both need to read it.
STDIN_PAYLOAD="$(cat)"

# Stage 0 — direct push to main is forbidden. Methodology requires feature branch + PR.
# Override is the same break-glass procedure as elsewhere (PR title `[break-glass]:` +
# entry in practices/break-glass-log.md). No --no-verify allowance.
current_branch="$(git rev-parse --abbrev-ref HEAD)"
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [[ -z "$remote_ref" ]] && continue
    if [[ "$remote_ref" == "refs/heads/main" && "$current_branch" == "main" ]]; then
        echo "[git] ✗ direct push to main is forbidden — methodology requires feature branch + PR" >&2
        echo "[git]   1. git checkout -b feature/<topic>" >&2
        echo "[git]   2. git push -u origin feature/<topic>" >&2
        echo "[git]   3. gh pr create --base main --head feature/<topic>" >&2
        echo "[git]   4. merge via PR (sentinel CI must be green first)" >&2
        echo "[git] Break-glass: see practices/DECISIONS-P3.md §Axis 3" >&2
        exit 1
    fi
done <<< "$STDIN_PAYLOAD"

# Determine the range of commits being pushed. If we cannot resolve a remote, default
# to comparing HEAD against the upstream tracking branch (when set); otherwise empty.
read_range() {
    local _local_ref _local_sha remote_ref remote_sha
    while read -r _local_ref _local_sha remote_ref remote_sha; do
        if [[ -n "$remote_sha" && "$remote_sha" != "0000000000000000000000000000000000000000" ]]; then
            echo "$remote_sha..HEAD"
            return
        fi
    done <<< "$STDIN_PAYLOAD"
    if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        echo "$(git rev-parse '@{u}')..HEAD"
    else
        echo ""
    fi
}

RANGE="$(read_range)"

# Skip when the push touches nothing under the regression scope.
if [[ -n "$RANGE" ]]; then
    if ! git diff --name-only "$RANGE" 2>/dev/null | grep -qE '^(backend/|practices/|specs/spring-practices-l0\.yaml)'; then
        exit 0
    fi
fi

echo "[practices] push detected — running full regression (testPractices + testAsvs + testCrud)"
if ! (cd backend && ./gradlew -q testPractices testAsvs testCrud); then
    echo "[practices] ✗ full regression FAILED — push BLOCKED"
    echo "[practices] Inspect the failing tests above. Re-run locally:"
    echo "[practices]   cd backend && ./gradlew testPractices testAsvs testCrud"
    exit 1
fi
echo "[practices] ✓ full regression PASS — push proceeds"
exit 0
