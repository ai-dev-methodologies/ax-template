/*
 * WebhookEndpoint.java.skeleton — R9 SP45 webhook L4 backend stub (sender axis).
 *
 * Rename to WebhookEndpoint.java in your fork.
 * Set the package to match your domain root (e.g. com.<org>.webhook).
 *
 * This stub satisfies WEBHOOK-EMIT-001 (specs/webhook-l0.yaml):
 *   "WebhookEndpointService.register() persists a new endpoint with url,
 *    active=true, signing_secret, and event_filter; registration is idempotent
 *    upsert keyed by URL."
 *
 * The per-endpoint signing_secret is generated by SecureRandom at create()
 * time and used as the HMAC-SHA256 key for every outbound delivery
 * (WEBHOOK-SIGN-001 / WEBHOOK-SIGN-002 — RFC 2104 + OWASP ASVS V13.2.6 anchor;
 * see templates/DECISIONS.md TD-2026-05-22-025 for the cryptographic-anchor
 * reuse rationale).
 *
 * Full domain implementation (HmacSigner, RetryPolicy, CircuitBreakerPolicy,
 * Service, Controller, WebhookDispatcher) lands when the first downstream
 * recipe consumes webhook — R9 SP45b internal-it.
 */

// package com.<org>.webhook;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

import java.security.SecureRandom;
import java.time.Instant;
import java.util.HexFormat;
import java.util.UUID;

@Entity
@Table(name = "webhook_endpoint")
public class WebhookEndpoint {

    private static final SecureRandom SECURE_RANDOM = new SecureRandom();
    private static final int SECRET_BYTES = 32; // 256-bit HMAC-SHA256 key per RFC 2104 §2

    @Id
    @Column(name = "id", nullable = false, updatable = false, length = 36)
    private String id;

    @Column(name = "url", nullable = false, unique = true, length = 2048)
    private String url;

    @Column(name = "active", nullable = false)
    private boolean active;

    /**
     * Per-endpoint HMAC-SHA256 signing secret. Storage is encrypted-at-rest
     * (KMS-managed key); rotation happens atomically on re-register
     * (WEBHOOK-EMIT-001 idempotent upsert). Never logged in plaintext.
     */
    @Column(name = "signing_secret", nullable = false, length = 128)
    private String signingSecret;

    /**
     * Comma-separated event-type glob list (e.g. "order.*,ticket.escalated").
     * Empty / "*" subscribes to all events.
     */
    @Column(name = "event_filter", nullable = false, length = 1024)
    private String eventFilter;

    @Column(name = "circuit_opened_at")
    private Instant circuitOpenedAt;

    @Column(name = "created_at", nullable = false, updatable = false)
    private Instant createdAt;

    @Column(name = "updated_at", nullable = false)
    private Instant updatedAt;

    protected WebhookEndpoint() { /* JPA */ }

    /** WEBHOOK-EMIT-001: factory yielding an active endpoint with a fresh 256-bit secret. */
    public static WebhookEndpoint create(String url, String eventFilter) {
        WebhookEndpoint e = new WebhookEndpoint();
        e.id = UUID.randomUUID().toString();
        e.url = url;
        e.active = true;
        e.signingSecret = generateSecret();
        e.eventFilter = eventFilter == null ? "*" : eventFilter;
        Instant now = Instant.now();
        e.createdAt = now;
        e.updatedAt = now;
        return e;
    }

    /** WEBHOOK-EMIT-001: secret rotation on idempotent re-register. */
    public void rotateSecret() {
        this.signingSecret = generateSecret();
        this.updatedAt = Instant.now();
    }

    /** WEBHOOK-CIRCUIT-001: terminal transition for circuit-breaker. */
    public void openCircuit() {
        this.active = false;
        this.circuitOpenedAt = Instant.now();
        this.updatedAt = this.circuitOpenedAt;
    }

    private static String generateSecret() {
        byte[] buf = new byte[SECRET_BYTES];
        SECURE_RANDOM.nextBytes(buf);
        return HexFormat.of().formatHex(buf);
    }

    public String getId() { return id; }
    public String getUrl() { return url; }
    public boolean isActive() { return active; }
    public String getSigningSecret() { return signingSecret; }
    public String getEventFilter() { return eventFilter; }
    public Instant getCircuitOpenedAt() { return circuitOpenedAt; }
    public Instant getCreatedAt() { return createdAt; }
    public Instant getUpdatedAt() { return updatedAt; }
}
