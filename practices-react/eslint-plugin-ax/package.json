{
  "name": "@ax/eslint-plugin-ax",
  "version": "0.1.0",
  "description": "Custom ESLint rules for the ax-template practices-react/ catalog. Each rule corresponds 1:1 to a practices-react/rules/*.md entry — evidence-anchored, codex-reviewed.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "rules/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "react",
    "nextjs",
    "ax-template",
    "react-server-components",
    "react-19",
    "nextjs-16"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ai-dev-methodologies/ax-template/tree/main/practices-react/eslint-plugin-ax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-dev-methodologies/ax-template.git",
    "directory": "practices-react/eslint-plugin-ax"
  },
  "bugs": {
    "url": "https://github.com/ai-dev-methodologies/ax-template/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "engines": {
    "node": ">=20"
  }
}
